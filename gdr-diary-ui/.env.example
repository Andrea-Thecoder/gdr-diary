VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=gdr-diary-dev
VITE_KEYCLOAK_CLIENT_ID=gdr-diary-api
VITE_API_BASE_URL=http://localhost:8080/api/v1/gdr-diary-api
VITE_MAX_SHEETS_PER_CHARACTER=10
# Optional. Domain of the theme cookie shared with the Keycloak login pages (online only)
# VITE_THEME_COOKIE_DOMAIN=example.com
# Optional. Controller details shown on /privacy. Both are needed, otherwise the page says they will be added
# VITE_PRIVACY_CONTROLLER_NAME=Name Surname
# VITE_PRIVACY_CONTACT_EMAIL=privacy@example.com
