{
  "realm": "gdr-diary-dev",
  "displayName": "GDR Diary (dev)",
  "loginTheme": "gdr-diary",
  "emailTheme": "gdr-diary",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "it"
  ],
  "defaultLocale": "it",
  "enabled": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@gdr-diary.local",
    "fromDisplayName": "Diario GDR",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "registrationAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 1296000,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "offlineSessionIdleTimeout": 2592000,
  "clientOfflineSessionIdleTimeout": 0,
  "offlineSessionMaxLifespanEnabled": false,
  "accessCodeLifespanLogin": 600,
  "accessCodeLifespanUserAction": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 2,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Can manage own characters, diaries and pages"
      },
      {
        "name": "admin",
        "description": "Administrator"
      }
    ]
  },
  "groups": [
    {
      "name": "users",
      "path": "/users",
      "realmRoles": [
        "user"
      ],
      "clientRoles": {
        "account": [
          "delete-account"
        ]
      }
    }
  ],
  "defaultGroups": [
    "/users"
  ],
  "clients": [
    {
      "clientId": "gdr-diary-api",
      "name": "GDR Diary",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "protocolMappers": [
        {
          "name": "gdr-diary-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "gdr-diary-backend",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "email-pending",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "kc.email.pending",
            "claim.name": "email_pending",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "baseUrl": "/"
    }
  ],
  "users": [
    {
      "username": "user1",
      "email": "user1@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "secret",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "admin1",
      "email": "admin1@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "secret",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    },
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 70
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": true,
      "defaultAction": false,
      "priority": 60
    },
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 100
    },
    {
      "alias": "update_user_locale",
      "name": "Update User Locale",
      "providerId": "update_user_locale",
      "enabled": true,
      "defaultAction": false,
      "priority": 1000
    }
  ]
}
